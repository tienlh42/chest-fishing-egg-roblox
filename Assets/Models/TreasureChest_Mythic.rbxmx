    <Item class="Script" referent="RBX2643"><Properties><string name="Name">ChestAnimator</string><token name="RunContext">2</token><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[-- Plays the KeyframeSequences in the "Animations" folder by writing Motor6D.Transform directly,
-- so no animation upload is needed. Runs on each client (RunContext = Client) because
-- Motor6D.Transform does not replicate. Change the model attribute "Anim" to switch animation.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local FADE_TIME = 0.15
local EASING_STYLES = {
	Linear = Enum.EasingStyle.Linear,
	Cubic = Enum.EasingStyle.Cubic,
	CubicV2 = Enum.EasingStyle.Cubic,
	Elastic = Enum.EasingStyle.Elastic,
	Bounce = Enum.EasingStyle.Bounce,
}

local goose = script.Parent

local motors = {}
for _, descendant in goose:GetDescendants() do
	if descendant:IsA("Motor6D") then
		motors[descendant.Part1.Name] = descendant
	end
end

local function loadAnimation(sequence)
	local keyframes = sequence:GetKeyframes()
	table.sort(keyframes, function(a, b)
		return a.Time < b.Time
	end)

	local tracks = {}
	for _, keyframe in keyframes do
		for _, pose in keyframe:GetDescendants() do
			if pose:IsA("Pose") and motors[pose.Name] then
				tracks[pose.Name] = tracks[pose.Name] or {}
				table.insert(tracks[pose.Name], {
					time = keyframe.Time,
					cframe = pose.CFrame,
					style = pose.EasingStyle.Name,
					direction = Enum.EasingDirection[pose.EasingDirection.Name],
				})
			end
		end
	end

	return { tracks = tracks, length = keyframes[#keyframes].Time, looped = sequence.Loop }
end

local animations = {}
for _, sequence in goose:WaitForChild("Animations"):GetChildren() do
	animations[sequence.Name] = loadAnimation(sequence)
end

local function sample(track, t)
	for i = 1, #track - 1 do
		local from, to = track[i], track[i + 1]
		if t < to.time then
			if from.style == "Constant" then
				return from.cframe
			end
			local alpha = math.max(t - from.time, 0) / (to.time - from.time)
			alpha = TweenService:GetValue(alpha, EASING_STYLES[from.style], from.direction)
			return from.cframe:Lerp(to.cframe, alpha)
		end
	end
	return track[#track].cframe
end

local current
local startTime
local fadeFrom = {}

local function play(name)
	current = animations[name]
	assert(current, goose.Name .. ": unknown animation " .. tostring(name))
	for jointName, motor in motors do
		fadeFrom[jointName] = motor.Transform
	end
	startTime = os.clock()
end

goose:GetAttributeChangedSignal("Anim"):Connect(function()
	play(goose:GetAttribute("Anim"))
end)
play(goose:GetAttribute("Anim"))

RunService.PreSimulation:Connect(function()
	local elapsed = os.clock() - startTime
	local t = if current.looped then elapsed % current.length else math.min(elapsed, current.length)
	local fade = math.min(elapsed / FADE_TIME, 1)
	for jointName, motor in motors do
		local track = current.tracks[jointName]
		local target = if track then sample(track, t) else CFrame.identity
		motor.Transform = fadeFrom[jointName]:Lerp(target, fade)
	end
end)
]]></ProtectedString></Properties>
    </Item>
    <Item class="Script" referent="RBX2644"><Properties><string name="Name">ChestEffects</string><token name="RunContext">2</token><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[-- Anime-style effects for the treasure chest, driven by the model attributes "Rarity" and "Anim"
-- (see STYLE_GUIDE.md). Runs on each client, uses only built-in particle textures.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local chest = script.Parent
local base = chest:WaitForChild("Base")

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 77)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(242, 194, 48)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(92, 214, 107)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(61, 184, 245)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(155, 107, 255)),
})

-- idleRate: sparkles per second while waiting, burst: sparkles when opened, rays: light beam on open.
local RARITIES = {
	Common = { color = Color3.fromRGB(245, 245, 240), idleRate = 0, burst = 12, rays = false },
	Rare = { color = Color3.fromRGB(61, 184, 245), idleRate = 3, burst = 25, rays = false },
	Epic = { color = Color3.fromRGB(155, 107, 255), idleRate = 6, burst = 45, rays = false },
	Legendary = { color = Color3.fromRGB(242, 194, 48), idleRate = 10, burst = 70, rays = true },
	Mythic = { color = Color3.fromRGB(255, 255, 255), idleRate = 14, burst = 100, rays = true, rainbow = true },
}
local SPLASH_COLOR = Color3.fromRGB(61, 184, 245)

local rarity = chest:GetAttribute("Rarity")
local config = assert(RARITIES[rarity], chest.Name .. ": unknown Rarity " .. tostring(rarity))
local size = base.Size

local outline = Instance.new("Highlight")
outline.FillTransparency = 1
outline.OutlineColor = config.color
outline.DepthMode = Enum.HighlightDepthMode.Occluded
outline.Parent = chest

local light = Instance.new("PointLight")
light.Color = config.color
light.Range = 0
light.Parent = base

local function newEmitter(color, rate, speed)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = if config.rainbow then RAINBOW else ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(speed * 0.6, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.2, size.Y * 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-120, 120)
	emitter.Parent = base
	return emitter
end

local sparkles = newEmitter(config.color, 0, 4)
local splash = newEmitter(SPLASH_COLOR, 0, 12)
local burst = newEmitter(config.color, 0, 22)

local function flash(peak)
	light.Range = peak
	TweenService:Create(light, TweenInfo.new(0.8), { Range = 0 }):Play()
end

local function showRays()
	local ray = Instance.new("Part")
	ray.Anchored = true
	ray.CanCollide = false
	ray.CanQuery = false
	ray.Material = Enum.Material.Neon
	ray.Color = config.color
	ray.Transparency = 0.4
	ray.Size = Vector3.new(size.X * 0.3, 1, size.X * 0.3)
	ray.CFrame = base.CFrame * CFrame.new(0, size.Y * 0.5 + 0.5, 0)
	ray.Parent = chest
	local goal = {
		Size = Vector3.new(size.X * 0.9, size.Y * 8, size.X * 0.9),
		CFrame = base.CFrame * CFrame.new(0, size.Y * 4.5, 0),
		Transparency = 1,
	}
	local tween = TweenService:Create(ray, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tween.Completed:Once(function()
		ray:Destroy()
	end)
	tween:Play()
end

local function fadeOut()
	for _, descendant in chest:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Transparency < 1 then
			TweenService:Create(descendant, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		end
	end
	TweenService:Create(outline, TweenInfo.new(0.5), { OutlineTransparency = 1 }):Play()
end

local function onAnim(name)
	sparkles.Rate = if name == "Idle" then config.idleRate else 0
	if name == "Spawn" then
		splash:Emit(30)
	elseif name == "Open" then
		task.delay(0.42, function()
			burst:Emit(config.burst)
			flash(12 + size.Y * 4)
			if config.rays then
				showRays()
			end
		end)
	elseif name == "Vanish" then
		task.delay(0.4, function()
			burst:Emit(config.burst * 0.5)
			fadeOut()
		end)
	end
end

chest:GetAttributeChangedSignal("Anim"):Connect(function()
	onAnim(chest:GetAttribute("Anim"))
end)
onAnim(chest:GetAttribute("Anim"))

-- Outline pulses to call attention; Mythic cycles through the rainbow.
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	if config.rainbow then
		outline.OutlineColor = Color3.fromHSV(t / 3 % 1, 0.6, 1)
	end
	if chest:GetAttribute("Anim") == "Idle" then
		outline.OutlineTransparency = 0.5 + 0.4 * math.sin(t * 5)
	end
end)
]]></ProtectedString></Properties>
    </Item>
    <Item class="Script" referent="RBX2645"><Properties><string name="Name">ChestSounds</string><token name="RunContext">2</token><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[-- Plays a sound for each chest action, driven by the model attributes "Rarity" and "Anim".
-- Upload the WAV files in Sounds/ to Roblox, then paste the ids below as "rbxassetid://123456".
-- An empty id is skipped, so the chest works silently until the sounds are uploaded.

local IDS = {
	Spawn = "",
	Idle = "",
	Open = "",
	Vanish = "",
	Chime = {
		Common = "",
		Rare = "",
		Epic = "",
		Legendary = "",
		Mythic = "",
	},
}

-- Seconds into Open at which the lid pops (matches the animation).
local LID_POP_TIME = 0.42
local IDLE_PERIOD = 1.4
local VOLUME = { Common = 0.5, Rare = 0.55, Epic = 0.65, Legendary = 0.75, Mythic = 0.8 }

local chest = script.Parent
local base = chest:WaitForChild("Base")
local rarity = chest:GetAttribute("Rarity")

local function play(soundId, volume)
	if soundId == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or VOLUME[rarity]
	sound.RollOffMaxDistance = 80
	sound.Parent = base
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	sound:Play()
end

local idleRun = 0

local function onAnim(name)
	idleRun += 1
	local run = idleRun
	if name == "Idle" then
		task.spawn(function()
			while idleRun == run do
				play(IDS.Idle, 0.4)
				task.wait(IDLE_PERIOD)
			end
		end)
	elseif name == "Open" then
		play(IDS.Open)
		task.delay(LID_POP_TIME, function()
			play(IDS.Chime[rarity])
		end)
	else
		play(IDS[name])
	end
end

chest:GetAttributeChangedSignal("Anim"):Connect(function()
	onAnim(chest:GetAttribute("Anim"))
end)
onAnim(chest:GetAttribute("Anim"))
]]></ProtectedString></Properties>
    </Item>
  </Item>
</roblox>
