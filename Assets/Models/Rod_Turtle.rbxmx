              <Item class="Pose" referent="RBX1147"><Properties><string name="Name">SpiritB</string><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><token name="EasingStyle">3</token><token name="EasingDirection">2</token><float name="Weight">1</float></Properties>
